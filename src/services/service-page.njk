---
pagination:
  data: services
  size: 1
  alias: service
permalink: "/services/{{ service.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ service.metaTitle }}"
  description: "{{ service.metaDescription }}"
---
{% from "partials/icons.njk" import icon %}
{% from "partials/illustrations.njk" import kitchenScene, officeScene, drivewayScene, emptyRoomScene, sofaScene, livingRoomScene %}

<section class="page-hero page-hero--split">
  <div class="container page-hero-grid">
    <div>
      {% set crumbs = [{label: "Services", url: "/services/"}, {label: service.name}] %}
      {% include "partials/breadcrumbs.njk" %}
      <h1>{{ service.heroHeadline }}</h1>
      <p class="lede">{{ service.heroSubheadline }}</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-accent">Get a Free Quote</a>
        <a href="tel:{{ site.phoneHref }}" class="btn btn-outline" style="color:#fff;border-color:#fff">Call {{ site.phone }}</a>
      </div>
    </div>
    <div class="hero-art-card page-hero-art" aria-hidden="true">
      {% if service.slug == "house-cleaning" %}{{ livingRoomScene(false) }}
      {% elif service.slug == "office-cleaning" %}{{ officeScene(false) }}
      {% elif service.slug == "driveway-exterior-cleaning" %}{{ drivewayScene(false) }}
      {% elif service.slug == "deep-cleaning-move-in-out" %}{{ emptyRoomScene(false) }}
      {% elif service.slug == "carpet-upholstery-cleaning" %}{{ sofaScene(false) }}{% endif %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-2" style="gap:3rem;align-items:start">
      <div class="prose">
        {% for para in service.overview.split("\n\n") %}
        <p>{{ para }}</p>
        {% endfor %}

        <h2>What's included</h2>
        <ul class="check-list">
          {% for item in service.whatsIncluded %}
          <li>{{ icon("check") }} <span>{{ item }}</span></li>
          {% endfor %}
        </ul>

        <h2>Ideal for</h2>
        <ul>
          {% for item in service.idealFor %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>

        <h2>Pricing</h2>
        <p>{{ service.pricingNote }}</p>
      </div>

      <div class="grid" style="gap:1.25rem">
        <div class="card">
          <div class="card-icon">{{ icon(service.icon) }}</div>
          <h3>Why customers choose this service</h3>
          <ul class="check-list">
            {% for b in service.benefits %}
            <li>{{ icon("check") }} <span><strong>{{ b.title }}:</strong> {{ b.description }}</span></li>
            {% endfor %}
          </ul>
        </div>
        <div class="card" style="background:var(--color-primary-light);border:none">
          <h3>Serving the whole GTA</h3>
          <p>{{ service.name }} is available across the Greater Toronto Area.</p>
          <p style="display:flex;flex-wrap:wrap;gap:0.5rem">
            {% for loc in locations %}
            <a class="tag-pill" href="/service-areas/{{ loc.slug }}/" style="text-decoration:none">{{ loc.name }}</a>
            {% endfor %}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="text-center" style="margin-bottom:2.5rem">
      <span class="eyebrow">How it works</span>
      <h2>What to expect</h2>
    </div>
    <ol class="steps">
      {% for step in service.process %}
      <li>
        <span class="step-num">{{ step.step }}</span>
        <h3>{{ step.title }}</h3>
        <p>{{ step.description }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="text-center" style="margin-bottom:2rem">
      <span class="eyebrow">FAQs</span>
      <h2>{{ service.name }} questions, answered</h2>
    </div>
    <div class="faq-list prose" style="max-width:820px;margin:0 auto">
      {% for item in service.faqs %}
      <details class="faq-item">
        <summary class="faq-question">{{ item.question }} <span class="plus">+</span></summary>
        <div class="faq-answer">{{ item.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="text-center" style="margin-bottom:2rem">
      <span class="eyebrow">Explore more</span>
      <h2>Other services from Neat Squad</h2>
    </div>
    <div class="grid grid-4">
      {% for s in services %}
      {% if s.slug != service.slug %}
      <div class="card">
        <div class="card-icon">{{ icon(s.icon) }}</div>
        <h3><a href="/services/{{ s.slug }}/">{{ s.name }}</a></h3>
        <p>{{ s.benefits[0].description }}</p>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {% set ctaHeadline = "Ready to book " + (service.name | lower) + "?" %}
    {% include "partials/cta-band.njk" %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": {{ service.name | dump | safe }},
  "provider": { "@id": "{{ site.url }}/#business" },
  "areaServed": [
    {% for loc in locations %}
    { "@type": "City", "name": {{ loc.name | dump | safe }} }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "description": {{ service.metaDescription | dump | safe }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in service.faqs %}
    {
      "@type": "Question",
      "name": {{ item.question | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
