---
layout: layouts/base.njk
permalink: /blog/
title: "Cleaning Tips & Guides | Neat Squad Blog"
description: "Practical cleaning tips and guides for GTA homeowners, renters, and businesses from the Neat Squad team."
---
<section class="page-hero">
  <div class="container">
    {% set crumbs = [{label: "Blog"}] %}
    {% include "partials/breadcrumbs.njk" %}
    <h1>Cleaning tips & guides</h1>
    <p class="lede">Practical advice for keeping GTA homes and offices spotless, from move-outs to office schedules.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="blog-index-list grid grid-3">
      {% for post in collections.posts %}
      <div class="card">
        <p class="blog-post-meta" style="margin-bottom:0.5rem">{{ post.data.date | postDate }}</p>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.description }}</p>
        <a class="card-link" href="{{ post.url }}">Read more →</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
