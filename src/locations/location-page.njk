---
pagination:
  data: locations
  size: 1
  alias: location
permalink: "/service-areas/{{ location.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ location.metaTitle }}"
  description: "{{ location.metaDescription }}"
---
{% from "partials/icons.njk" import icon %}

<section class="page-hero">
  <div class="container">
    {% set crumbs = [{label: "Service Areas", url: "/service-areas/"}, {label: location.name}] %}
    {% include "partials/breadcrumbs.njk" %}
    <h1>{{ location.heroHeadline }}</h1>
    <p class="lede">Cleaning services for homes and businesses in {{ location.name }}, {{ location.region }}.</p>
    <div class="hero-actions">
      <a href="/contact/" class="btn btn-accent">Get a Free Quote</a>
      <a href="tel:{{ site.phoneHref }}" class="btn btn-outline" style="color:#fff;border-color:#fff">Call {{ site.phone }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-2" style="gap:3rem;align-items:start">
      <div class="prose">
        {% for para in location.intro.split("\n\n") %}
        <p>{{ para }}</p>
        {% endfor %}

        <h2>Neighbourhoods we serve in {{ location.name }}</h2>
        <p style="display:flex;flex-wrap:wrap;gap:0.5rem">
          {% for n in location.neighborhoods %}
          <span class="tag-pill">{{ n }}</span>
          {% endfor %}
        </p>

        <h2>Services available in {{ location.name }}</h2>
        <div class="grid grid-2" style="margin-top:1rem">
          {% for s in services %}
          <a class="card" href="/services/{{ s.slug }}/" style="text-decoration:none;display:flex;gap:0.75rem;align-items:center;padding:1rem 1.25rem">
            <span style="color:var(--color-primary)">{{ icon(s.icon) }}</span>
            <span style="font-weight:700;color:var(--color-ink)">{{ s.name }}</span>
          </a>
          {% endfor %}
        </div>
      </div>

      <div class="grid" style="gap:1.25rem">
        {% for w in location.whyChooseUs %}
        <div class="card">
          <div class="card-icon">{{ icon("check") }}</div>
          <h3>{{ w.title }}</h3>
          <p>{{ w.description }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="text-center" style="margin-bottom:2rem">
      <span class="eyebrow">{{ location.name }} FAQs</span>
      <h2>Common questions from {{ location.name }} clients</h2>
    </div>
    <div class="faq-list prose" style="max-width:820px;margin:0 auto">
      {% for item in location.localFaqs %}
      <details class="faq-item">
        <summary class="faq-question">{{ item.question }} <span class="plus">+</span></summary>
        <div class="faq-answer">{{ item.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="text-center" style="margin-bottom:2rem">
      <span class="eyebrow">Nearby areas</span>
      <h2>We also serve</h2>
    </div>
    <div class="grid grid-4">
      {% for loc in locations %}
      {% if loc.slug != location.slug %}
      <a class="card" href="/service-areas/{{ loc.slug }}/" style="text-decoration:none">
        <h3 style="margin-bottom:0.25rem">{{ loc.name }}</h3>
        <p style="margin:0;color:var(--color-ink-soft);font-size:0.9rem">{{ loc.region }}</p>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    {% set ctaHeadline = "Ready to book cleaning in " + location.name + "?" %}
    {% include "partials/cta-band.njk" %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in location.localFaqs %}
    {
      "@type": "Question",
      "name": {{ item.question | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
